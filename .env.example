# Resend API key for contact form email delivery. Get one at https://resend.com
RESEND_API_KEY=

# Company inbox that receives contact form submissions.
CONTACT_EMAIL_TO=info@nicekgroup.com

# Sender address. mail.nicekgroup.com is verified as a Resend sending
# domain, so use an address on it rather than Resend's shared
# onboarding@resend.dev, which only delivers to the Resend account's own
# email until a domain is verified.
CONTACT_EMAIL_FROM=noreply@mail.nicekgroup.com

# Optional. Canonical site URL used to resolve absolute URLs for Open Graph
# and Twitter card images. Falls back to Vercel's auto-provided VERCEL_URL,
# then to localhost, if unset - only needed to pin a stable production
# domain once one is chosen.
NEXT_PUBLIC_SITE_URL=

# Comma-separated email address(es) allowed to view /careers/admin. Just the
# client's email today - there is no roles table, this is the whole gate.
ADMIN_EMAILS=
